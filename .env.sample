# Compose
DOCKER_CONTAINER_NAME=nextcloud
DOCKER_PORT=8080

# Nextcloud — local administrator (not LDAP)
NEXTCLOUD_ADMIN_USER=ncadmin
NEXTCLOUD_ADMIN_PASSWORD=change-me-nextcloud-admin
NEXTCLOUD_URL=https://cloud.example.com

# PostgreSQL — dedicated role and database for the cloud only
POSTGRES_HOST=postgres
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=change-me-postgres

# Outbound mail
MAIL_SMTPS=ssl://mail.example.com
MAIL_PORT=465
MAIL_FROM_ADDRESS=cloud@example.com
MAIL_DOMAIN=example.com
MAIL_AUTH_MODES=login
MAIL_USER=cloud@example.com
MAIL_PASSWORD=change-me-mail

# Active Directory
LDAP_HOST=dc.example.com
LDAP_PORT=389
LDAP_BASE="OU=Accounts,DC=example,DC=com"
LDAP_AGENTNAME="CN=Cloud,OU=Users,OU=Accounts,DC=example,DC=com"
LDAP_AGENTPASSWORD="change-me-ldap-bind"

# Theming
THEMING_NAME=Cloud
THEMING_SLOGAN="Corporate file cloud"
THEMING_URL=https://cloud.example.com
THEMING_PRIMARYCOLOR="#00679e"

# Collabora Online (CODE)
COLLABORA_PORT=9980
COLLABORA_URL=https://collabora.example.com
COLLABORA_ALIASGROUP=https://cloud.example.com:443
COLLABORA_WOPI_HOST=cloud.example.com
COLLABORA_ADMIN_USER=admin
COLLABORA_ADMIN_PASSWORD=change-me-collabora-admin
