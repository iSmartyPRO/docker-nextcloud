# Collabora Online (CODE) reverse proxy.
# Container listens on host port COLLABORA_PORT (default 9980).

upstream collabora_backend {
    server 127.0.0.1:9980;
}

server {
    listen 80;
    listen [::]:80;
    server_name collabora.example.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name collabora.example.com;

    ssl_certificate     /etc/letsencrypt/live/collabora.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/collabora.example.com/privkey.pem;
    ssl_session_cache shared:SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;

    location ^~ /browser {
        proxy_pass http://collabora_backend;
        proxy_set_header Host $http_host;
    }

    location ^~ /hosting/discovery {
        proxy_pass http://collabora_backend;
        proxy_set_header Host $http_host;
    }

    location ^~ /hosting/capabilities {
        proxy_pass http://collabora_backend;
        proxy_set_header Host $http_host;
    }

    location ^~ /cool/adminws {
        proxy_pass http://collabora_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_read_timeout 36000s;
    }

    location ^~ /cool {
        proxy_pass http://collabora_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_read_timeout 36000s;
        proxy_send_timeout 36000s;
    }

    location ^~ /lool {
        proxy_pass http://collabora_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_read_timeout 36000s;
    }
}
